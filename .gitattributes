# Normalizar saltos de línea al hacer commit
* text=auto eol=lf

# Archivos que siempre deben ser LF
*.py text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env.example text eol=lf

# Archivos binarios — Git no debe tocarlos
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
